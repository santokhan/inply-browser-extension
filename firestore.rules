rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function enabledOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && (!exists(/databases/$(database)/documents/tenants/$(uid))
          || get(/databases/$(database)/documents/tenants/$(uid)).data.get('disabled', false) != true);
    }

    match /tenants/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['disabled'])
        && request.resource.data.disabled == false;
      // Account access is managed through the Firebase Console or Admin SDK.
      allow update, delete: if false;
    }

    match /customerProfiles/{userId} {
      allow read, write: if enabledOwner(userId);
    }

    match /customerOwners/{ownerId}/customers/{customerId} {
      allow read, write: if enabledOwner(ownerId);
    }

    match /tenantTenderBaskets/{uid} {
      allow read, write: if enabledOwner(uid);
    }

    match /notices/{uid}/items/{noticeId} {
      allow read, write: if enabledOwner(uid);
    }

    match /ltmTenderForms/{uid} {
      allow get, create, update: if enabledOwner(uid);
    }

    match /tenantWallets/{uid} {
      function ownsWallet() {
        return enabledOwner(uid);
      }

      function currentWeek() {
        return int((request.time.toMillis() - 345600000) / 604800000);
      }

      function validWallet() {
        let data = request.resource.data;

        return data.keys().hasOnly([
            'grantBalance', 'purchasedBalance', 'lastGrantWeek', 'createdAt', 'updatedAt'
          ])
          && data.grantBalance is int
          && data.grantBalance >= 0
          && data.grantBalance <= 50
          && data.purchasedBalance is int
          && data.purchasedBalance >= 0
          && data.purchasedBalance <= 9007199254740991
          && data.lastGrantWeek is int
          && data.lastGrantWeek == currentWeek()
          && data.updatedAt == request.time;
      }

      function migratesLegacyWallet() {
        let previous = resource.data;
        let next = request.resource.data;
        return previous.keys().hasOnly(['balance', 'lastGrantWeek', 'createdAt', 'updatedAt'])
          && previous.balance is int
          && previous.balance >= 0
          && previous.lastGrantWeek is int
          && previous.lastGrantWeek <= currentWeek()
          && next.purchasedBalance == 0
          && next.grantBalance == (previous.lastGrantWeek < currentWeek()
            ? 50 : (previous.balance < 50 ? previous.balance : 50));
      }

      function refreshesWeeklyGrant() {
        return resource.data.lastGrantWeek < currentWeek()
          && request.resource.data.grantBalance == 50
          && request.resource.data.purchasedBalance == resource.data.purchasedBalance;
      }

      function deductsCredits() {
        let previous = resource.data;
        let next = request.resource.data;
        return previous.lastGrantWeek == currentWeek()
          && next.grantBalance <= previous.grantBalance
          && next.purchasedBalance <= previous.purchasedBalance
          && (next.grantBalance < previous.grantBalance
            || next.purchasedBalance < previous.purchasedBalance)
          && (next.purchasedBalance == previous.purchasedBalance || next.grantBalance == 0);
      }

      allow get: if ownsWallet();

      allow create: if ownsWallet()
        && validWallet()
        && request.resource.data.grantBalance == 50
        && request.resource.data.purchasedBalance == 0
        && request.resource.data.createdAt == request.time;

      allow update: if ownsWallet()
        && validWallet()
        && request.resource.data.createdAt == resource.data.createdAt
        && (('balance' in resource.data && migratesLegacyWallet())
          || (!('balance' in resource.data)
            && (refreshesWeeklyGrant() || deductsCredits())));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
